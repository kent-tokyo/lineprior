{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kent-tokyo/lineprior/blob/main/docs/measurements/offpolicy-observation-v1.schema.json",
  "title": "lineprior OffPolicyObservation JSONL row v1",
  "type": "object",
  "required": ["state", "action", "reward", "logging_propensity", "evaluation_probability"],
  "properties": {
    "state": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "reward": {"type": "number"},
    "logging_propensity": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "evaluation_probability": {"type": "number", "minimum": 0, "maximum": 1},
    "reward_model_policy_value": {"type": ["number", "null"]},
    "reward_model_logged_action": {"type": ["number", "null"]},
    "metadata": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  },
  "additionalProperties": true
}
